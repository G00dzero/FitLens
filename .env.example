# URL for the separate VITON-HD inference service.
# The service must accept multipart fields: person and garment.
# It must return JSON: { "resultUrl": "https://...", "jobId": "optional" }
VITE_VITON_API_URL=http://localhost:8000/inference

# URL for the image-to-3D-body service.
# It must accept multipart field: image.
# It must return JSON: { "modelUrl": "https://...", "previewUrl": "optional", "jobId": "optional" }
VITE_BODY_3D_API_URL=http://localhost:8001/body-reconstruction

# URL for the garment 3D reconstruction service (accepts a GLB/glTF or garment image).
VITE_GARMENT_3D_API_URL=http://localhost:8002/garment-reconstruction

# Optional local ICON adapter (server/icon_service.py). Use these instead of the remote endpoints above.
# VITE_GARMENT_3D_API_URL=http://127.0.0.1:8010/garment-reconstruction
# VITE_BODY_3D_API_URL=http://127.0.0.1:8010/body-reconstruction

# URL for the service that merges the body and garment models.
VITE_MERGE_3D_API_URL=http://localhost:8003/merge

# Copy this file to .env.local and paste the current Web API key from Firebase Console.
VITE_FIREBASE_API_KEY="AIzaSyD-KocuOcC8bGuowDFsPe9WyY8-u7-K13U"
